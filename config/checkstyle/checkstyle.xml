<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Curated minimal ruleset: hygiene that spotless does not cover.
     Every rule here must hold on the existing tree; add rules only
     after verifying they pass, so `check` never fails on legacy code. -->
<module name="Checker">
    <property name="severity" value="error"/>
    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>
        <module name="ModifierOrder"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="OneTopLevelClass"/>
        <!-- Inline fully-qualified type names must be imported instead.
             Comments are exempt (ignoreComments); the sanctioned exception is
             a genuine same-simple-name collision — none exists today. -->
        <module name="RegexpSinglelineJava">
            <property name="format"
                      value="^\s+(?!\*|//).*(?&lt;![\w.&quot;])(?:java|javax|io|appeng|net\.minecraft|net\.minecraftforge|com\.ae2vm|com\.glodblock|com\.google|com\.moakiee)\.(?:[a-z0-9]+\.)*[A-Z]"/>
            <property name="message"
                      value="inline fully-qualified type: import it instead (sanctioned exception: same-simple-name collision)"/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
</module>
